# Copy this file to .env and fill in values your project needs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# LM Studio local model — REST API v1 (base URL, no path).
# The backend runs in Docker: host.docker.internal reaches LM Studio on your
# machine. Use http://localhost:1234 only when running the API outside Docker.
LM_STUDIO_URL=http://host.docker.internal:1234
LM_STUDIO_MODEL=google/gemma-4-26b-a4b
LM_STUDIO_TIMEOUT=60

# Admin panel (http://localhost:8000/admin) — HTTP Basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Ports exposed by docker-compose.yml
JUPYTER_PORT=8888
API_PORT=8000
STREAMLIT_PORT=8501
GRADIO_PORT=7860
