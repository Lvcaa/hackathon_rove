# Copy this file to .env and fill in values your project needs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# LM Studio local model API (Gemma 27B or any OpenAI-compatible model)
# Inside Docker use http://host.docker.internal:1234/v1
LM_STUDIO_URL=http://localhost:1234/v1

# Admin panel (http://localhost:8000/admin) — HTTP Basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Ports exposed by docker-compose.yml
JUPYTER_PORT=8888
API_PORT=8000
STREAMLIT_PORT=8501
GRADIO_PORT=7860
